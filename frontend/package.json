{
  "name": "fintrack-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "FinTrack — SPA-клієнт обліку особистих і сімейних фінансів (React)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
